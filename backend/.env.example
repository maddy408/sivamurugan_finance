# Copy to .env and adjust for your machine / server.
APP_ENV=local
APP_URL=http://localhost/siva-murugan-chit-fund/backend/public
APP_DEBUG=true
TIMEZONE=Asia/Kolkata

# --- Database ---
# This app uses its OWN database. Do NOT point it at another application's DB.
# XAMPP ships MariaDB on port 3306 with an empty root password by default.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=siva_murugan_chit_fund
DB_USERNAME=root
DB_PASSWORD=

# Browser origins allowed to call the API (Vite dev server + Apache-served build).
# In production set this to your real web origin(s), comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost,http://127.0.0.1

# Bearer token lifetime (hours). Also configurable in app_settings.security.
TOKEN_TTL_HOURS=12
